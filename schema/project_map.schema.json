{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectMapV2",
  "description": "Project Memory V2.0 Codebase Map / GPS Schema",
  "type": "object",
  "required": [
    "version",
    "project_name",
    "domains",
    "infrastructure"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "files",
          "tests"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "entry_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "config_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cicd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectStateV2",
  "description": "Project Memory V2.0 State Machine Schema",
  "type": "object",
  "required": [
    "version",
    "project_name",
    "mission",
    "current_phase",
    "status",
    "active_task",
    "verified_commit",
    "last_updated",
    "metrics",
    "constraints"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "current_phase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["INITIALIZING", "IN_PROGRESS", "PAUSED", "COMPLETED", "BLOCKED"]
    },
    "active_task": {
      "type": "string"
    },
    "verified_commit": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "required": [
        "bootstrap_context_bytes",
        "total_agent_system_bytes",
        "completed_tasks_count"
      ],
      "properties": {
        "bootstrap_context_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_agent_system_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "completed_tasks_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_suite_status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
